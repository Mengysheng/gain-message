{
  "name": "notice-radar",
  "version": "0.1.0",
  "description": "按关键词监控学校官网新通告，去重后邮件汇总｜Keyword-filtered notice monitor for university notice boards, with email digest",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "notice-radar": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "doctor": "node src/cli.js doctor",
    "demo": "node src/cli.js demo",
    "inspect": "node src/cli.js inspect",
    "check": "node src/cli.js test",
    "run": "node src/cli.js run",
    "dev": "node --env-file-if-exists=.env src/cli.js run --dry-run --no-email --preview out/preview.html",
    "smtp": "node --env-file-if-exists=.env src/cli.js check-smtp"
  },
  "keywords": [
    "monitor",
    "notice",
    "university",
    "email",
    "digest",
    "scraper",
    "crawler",
    "school",
    "notification"
  ],
  "files": [
    "src",
    "docs",
    "examples",
    "config.example.yaml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USER/notice-radar.git"
  },
  "bugs": {
    "url": "https://github.com/USER/notice-radar/issues"
  },
  "homepage": "https://github.com/USER/notice-radar#readme",
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.2.0",
    "iconv-lite": "^0.7.3",
    "nodemailer": "^10.3.1",
    "yaml": "^2.9.1"
  }
}
